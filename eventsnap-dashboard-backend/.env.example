# EventSnap dashboard backend — environment variables.
# Copy to `.env` and fill in real values. Never commit the real `.env`
# (it is git-ignored). No credentials belong in this example file.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017/eventsnap
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte key (hex or 32+ chars) used to encrypt stored account secrets.
ACCOUNT_ENCRYPTION_KEY=change-me-32-characters-minimum--

# ── Optional: company website sync (leave unset to disable) ──────────────────
COMPANY_WEBSITE_SYNC_URL=
COMPANY_WEBSITE_API_KEY=

# ── Email / SMTP (Nodemailer) ────────────────────────────────────────────────
# Used for portfolio enquiry notifications, booking confirmations, and the
# password-reset security notice. If SMTP_HOST is left blank, email is simply
# disabled (the app logs and continues — nothing is sent, nothing breaks).
#
# Example for a Gmail account using an App Password (Google Account →
# Security → 2-Step Verification → App passwords). Spaces in the App Password
# are ignored automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for 587/STARTTLS. Defaults to true only for 465.
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional "From" header; defaults to SMTP_USER. Can be "Name <addr@host>".
SMTP_FROM=

# ── Optional: Direct Camera Auto Upload (Create Event) ─────────────────────
# Compatible cameras (FTP-transfer cameras such as Nikon Z8/Z9, Sony Alpha,
# Canon EOS R) upload new photos straight to an event over FTPS. Cameras
# connect to a separate ingestion service (`npm run direct-camera`), which
# needs a host with open TCP ports — Render web services can't accept FTP.
# It uses the same MONGO_URL, so photos land in the event's gallery.
#
# On the HTTP API (shown to photographers in the dashboard; leave blank until
# the ingestion service is deployed):
#   DIRECT_CAMERA_HOST  public hostname of the ingestion service
#   DIRECT_CAMERA_PORT  its FTPS control port (as reachable from cameras)
DIRECT_CAMERA_HOST=
DIRECT_CAMERA_PORT=
#
# On the ingestion service:
#   DIRECT_CAMERA_FTP_PORT      port it listens on (default 2121)
#   DIRECT_CAMERA_PASV_PORTS    passive data ports, open them in the firewall
#                               (default 30000-30009)
#   DIRECT_CAMERA_PASV_ADDRESS  the host's public IPv4 (sent to cameras in PASV)
#   DIRECT_CAMERA_TLS_CERT / DIRECT_CAMERA_TLS_KEY  certificate + key files
#                               for DIRECT_CAMERA_HOST (e.g. Let's Encrypt);
#                               required — plain FTP is never accepted
#   DIRECT_CAMERA_MAX_MB        largest photo accepted (default 25)
DIRECT_CAMERA_FTP_PORT=
DIRECT_CAMERA_PASV_PORTS=
DIRECT_CAMERA_PASV_ADDRESS=
DIRECT_CAMERA_TLS_CERT=
DIRECT_CAMERA_TLS_KEY=
DIRECT_CAMERA_MAX_MB=

# ── Create Event storage quota (per photographer) ─────────────────────────
# STORAGE_QUOTA_GB: EACH photographer's own limit for their Create Event
# photos (gallery + covers, S3 and GridFS together), in GB. Default 3 when
# blank or invalid. Uploads past it are refused with "Storage limit
# reached…"; deleting photos frees space at once. Not shared between
# photographers — see S3_STORAGE_LIMIT_GB below for a whole-bucket cap.
STORAGE_QUOTA_GB=3
#   background cleanup + usage recount interval (ms); default 600000 (10 min)
STORAGE_CLEANUP_INTERVAL_MS=

# ── Optional: AWS S3 photo storage (Create Event) ─────────────────────────
# Credentials: use the AWS SDK's standard variables below, or (better, when
# hosted on AWS) an IAM role. Never put them in the dashboard UI or commit them.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# S3: when set, NEW Create Event photos are stored in this PRIVATE bucket
# (originals unchanged); leave blank to keep using MongoDB GridFS. Photos
# already in GridFS are never moved. The bucket's CORS must allow GET from the
# dashboard origins (the in-browser Face Search reads photos).
S3_PHOTO_BUCKET=
#   S3_STORAGE_LIMIT_GB: optional cap on the WHOLE bucket (all photographers
#   together, S3 photos only), in GB (e.g. 5) — a cost guard, separate from
#   the per-photographer STORAGE_QUOTA_GB. Both apply: an upload must fit
#   both. Past it, uploads are refused with "Photo storage is full".
#   Blank/0 = no bucket-wide cap.
S3_STORAGE_LIMIT_GB=
#
# ── Optional: "People" grouping (Create Event, photographer-only) ────────
# Runs on THIS server with a free library (@vladmandic/human) — no cloud face
# service. Off unless "true". Uses CPU and ~150–250 MB extra memory while
# processing — keep it "false" on small hosts such as Render Free (512 MB).
# Grouping is approximate.
FACE_GROUPING_ENABLED=false
#   similarity (0.3–0.95) for "same person"; default 0.5 (higher = stricter)
FACE_GROUPING_THRESHOLD=
#   how often the background worker runs (ms); default 15000
FACE_GROUPING_INTERVAL_MS=
