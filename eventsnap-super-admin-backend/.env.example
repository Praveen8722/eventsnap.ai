# Copy to .env and adjust. Never commit .env.

PORT=4000

# The ADMIN database: admin accounts, roles, settings, support tickets, notifications, audit log.
MONGODB_URI=mongodb://127.0.0.1:27017/eventsnap_admin

# The EventSnap PLATFORM database (the photographer dashboard's MongoDB, e.g. eventSnapDB), read
# live and never written. In production, use a MongoDB user that has ONLY the "read" role on that
# database, e.g. mongodb+srv://admin-readonly:<password>@<cluster>/eventSnapDB
# Unset: platform pages (photographers, bookings, revenue, …) return 503 explaining it isn't set.
PLATFORM_MONGO_URL=
# Per-photographer storage quota on the platform (match the dashboard backend's STORAGE_QUOTA_GB).
PLATFORM_STORAGE_QUOTA_GB=3
# Seconds platform figures are reused between requests (0 = always live).
PLATFORM_CACHE_SECONDS=30
# Timezone for calendar months in charts ("this month", monthly series).
REPORT_TIMEZONE=Asia/Kolkata

# Required in production; at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Sign-in lockout: failed attempts per email / per IP allowed within the window.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# One-time code needed to create the first Super Admin on the login page (first-time setup).
# REQUIRED in production (setup is disabled there without it); optional locally. Remove it after setup.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SETUP_TOKEN=

# Public address of the admin UI, used to build invite links.
ADMIN_UI_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Set to true when running behind a reverse proxy so audit logs and the lockout see the real client IP.
TRUST_PROXY=false

# First Super Admin created by `npm run seed` (and the password of demo admins in dev:memory).
# In production the seed requires a password of at least 12 characters.
SEED_ADMIN_EMAIL=admin@eventsnap.ai
SEED_ADMIN_PASSWORD=admin123

# Set to true (or pass --memory) to run against a temporary in-memory MongoDB with demo admins.
USE_MEMORY_DB=false
